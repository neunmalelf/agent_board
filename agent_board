#!/usr/bin/env bash
# agent_board - manage the agent_board service: start/stop/restart/status/view
#
#   agent_board start     # install + enable + start the systemd user service
#   agent_board stop      # stop + disable the service
#   agent_board status    # service state + the current board frame
#   agent_board view      # foreground fullscreen TUI (exec agent_board.py)
#   agent_board logs [n]  # last n journal lines of the service
set -u

UNIT="agent_board.service"
UNIT_SRC="$HOME/projects/agent_board/systemd/agent_board.service"
UNIT_DST="$HOME/.config/systemd/user/$UNIT"
FRAME="$HOME/.local/state/agent_board/board.txt"

install_unit() {
    if [ ! -f "$UNIT_DST" ]; then
        mkdir -p "$HOME/.config/systemd/user"
        cp "$UNIT_SRC" "$UNIT_DST"
        systemctl --user daemon-reload
    fi
}

case "${1:-status}" in
    start)
        install_unit
        systemctl --user enable --now "$UNIT"
        echo "agent-board: service started (frame: $FRAME)"
        ;;
    stop)
        systemctl --user disable --now "$UNIT" 2>/dev/null
        echo "agent-board: service stopped"
        ;;
    restart)
        install_unit
        systemctl --user restart "$UNIT"
        echo "agent-board: service restarted"
        ;;
    status)
        state=$(systemctl --user is-active "$UNIT" 2>/dev/null) || state=inactive
        enabled=$(systemctl --user is-enabled "$UNIT" 2>/dev/null) || enabled=disabled
        echo "service: $state ($enabled)"
        if [ -f "$FRAME" ]; then
            echo "frame: $(date -r "$FRAME" '+%Y-%m-%d %H:%M:%S')"
            cat "$FRAME"
        else
            echo "frame: not written yet (run: agent_board start, or agent-board --once)"
        fi
        ;;
    view|view-compact)
        compact=""
        [ "$1" = "view-compact" ] && compact=1
        shift
        period=30
        while [ $# -gt 0 ]; do
            case "$1" in
                --autorefresh=*) period="${1#--autorefresh=}" ;;
                --autorefresh) shift; period="${1:-30}" ;;
                *) echo "agent_board: view: unknown option: $1" >&2; exit 2 ;;
            esac
            shift
        done
        if [ -n "$compact" ]; then
            exec "$HOME/sbin/agent_board.py" --compact --autorefresh "$period"
        fi
        exec "$HOME/sbin/agent_board.py" --autorefresh "$period"
        ;;
    help|-h|--help)
        echo "agent_board - manage the agent_board service"
        echo ""
        echo "  start         install (if needed) + enable + start the systemd user service"
        echo "  stop          stop + disable the service"
        echo "  restart       restart the service"
        echo "  status        service state + the current board frame"
        echo "  view          fullscreen TUI (exec agent_board.py) [--autorefresh s]"
        echo "  view-compact  compact TUI, one line per agent [--autorefresh s]"
        echo "  logs [n]      last n journal lines of the service (default 50)"
        echo "  --version     print the agent_board version"
        ;;
    logs)
        journalctl --user -u "$UNIT" -n "${2:-50}" --no-pager
        ;;
    version|-v|--version)
        "$HOME/sbin/agent_board.py" --version
        ;;
    *)
        echo "usage: agent_board {start|stop|restart|status|view|view-compact [--autorefresh s]|logs [n]|help|--version}" >&2
        exit 2
        ;;
esac